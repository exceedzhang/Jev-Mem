# Copy to .env and fill in your local credentials.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# JEV_* aliases win over TYPESAFE_* when set; use them for a locally
# deployed / self-hosted Jev-compatible endpoint:
JEV_BASE_URL=
JEV_API_KEY=
JEV_MODEL=jev-latest
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
# --- Storage backend: postgres (default in the container) or file ---
# JEV_MEM_STORAGE=file restores the per-namespace file layout.
# JEV_MEM_STORAGE=postgres
# JEV_MEM_PG_DSN=postgresql://postgres:postgres@host.docker.internal:15432/jev_mem
# JEV_MEM_PG_VECTOR_DIM=2560
# JEV_MEM_GRAPH_STORAGE=table
