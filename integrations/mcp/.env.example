# Jev-Mem MCP server configuration
# Copy to a real .env (or export these) before starting integrations/mcp/server.py.

# Base URL of the running sidecar service (no trailing slash needed).
JEV_MEM_MCP_BASE_URL=http://localhost:8700

# Same key as the sidecar's JEV_MEM_API_KEY (Authorization: Bearer ...).
JEV_MEM_MCP_API_KEY=

# The single tenant this MCP deployment serves (one namespace per deployment).
JEV_MEM_MCP_NAMESPACE=opencode

# Bind address/port for the MCP HTTP/SSE endpoint.
JEV_MEM_MCP_HOST=0.0.0.0
JEV_MEM_MCP_PORT=8701

# Set to the sidecar's base URL to enable the live smoke test; unset = skipped.
# JEV_MEM_MCP_TEST_URL=http://localhost:8700
