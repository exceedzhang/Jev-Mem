# Jev-Mem Dify sidecar service environment
# Copy to .env and adjust (or export the variables in your shell).

# --- OpenAI-compatible endpoint (shared by the LLM and embeddings) ---
# E.g. the same provider you configured in Dify (DeepSeek, Moonshot,
# OpenRouter, local Ollama/vLLM/one-api gateway, ...).
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Model name on that endpoint (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# --- Embeddings: API, not the local model ---
# Setting OPENAI_EMBEDDING_MODEL switches embeddings from the local minilm
# encoder to the API endpoint above (shares OPENAI_BASE_URL / OPENAI_API_KEY).
OPENAI_EMBEDDING_MODEL=
# dimension is auto-detected (native model dimension, `dimensions` param
# omitted). Only set this for Matryoshka-capable models (e.g.
# text-embedding-3-small): vLLM-served Qwen embeddings reject the parameter.
# OPENAI_EMBEDDING_DIMENSIONS=1536

# --- System-One decision model: locally deployed Jev-compatible endpoint ---
# Point to your self-hosted Jev-compatible API (TypeSafe protocol).
# Legacy TYPESAFE_BASE_URL / TYPESAFE_DEFAULT_MODEL / TYPESAFE_API_KEY still
# work and are used as fallback when the JEV_* variables are unset.
JEV_BASE_URL=
JEV_API_KEY=
JEV_MODEL=jev-latest

# --- Storage backend: postgres (default) or file ---
# The container deployment defaults to PostgreSQL: one transactional store for
# graph / vectors / keywords / namespaces, safe when more than one process may
# touch the data directory. JEV_MEM_STORAGE=file restores the per-namespace
# file layout (graph.json + index.faiss + keyword_index.json). See
# docs/postgresql_storage.md.
JEV_MEM_STORAGE=postgres
JEV_MEM_PG_DSN=postgresql://postgres:postgres@host.docker.internal:15432/jev_mem
# Dimension of the pgvector column; must match the embedding model's
# dimension or the store fails fast (default 2560).
JEV_MEM_PG_VECTOR_DIM=2560
# Graph storage implementation: table (default). age is a reserved knob,
# not implemented.
# JEV_MEM_GRAPH_STORAGE=table

# --- Optional sidecar settings ---
# Jev-Mem repo root (auto-detected; set when running from elsewhere)
# JEV_MEM_HOME=/path/to/Jev-Mem
# Config profile (defaults to $JEV_MEM_HOME/config/jev_mem.json)
# JEV_MEM_PROFILE=
# Memory persistence base dir (defaults to $JEV_MEM_HOME/cache/dify)
# JEV_MEM_CACHE_DIR=
# 1 = fully offline mock (no API keys needed)
# JEV_MEM_MOCK=1
# If set, /v1/* requires "Authorization: Bearer <key>"
# JEV_MEM_API_KEY=
# Explicit embedding backend override: "openai" (API) or "minilm" (local).
# Unset = API when OPENAI_EMBEDDING_MODEL is set, otherwise local minilm.
# JEV_MEM_EMBEDDING_MODEL=
# Listening port (default: 8700)
# JEV_MEM_PORT=8700
# Max concurrently resident namespaces (default: 8)
# JEV_MEM_MAX_NAMESPACES=8
